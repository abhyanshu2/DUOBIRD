# Firebase project config (from Firebase Console > Project Settings > General > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The only two people allowed to use this app.
# These are just display identities, not accounts — no passwords, no signup.
VITE_USER_A_NAME=Aarav
VITE_USER_A_AVATAR=A
VITE_USER_B_NAME=Isha
VITE_USER_B_AVATAR=I

# Shared secret both people know (acts as a simple door key so strangers
# can't pick a name and land in your conversation). Change this to anything.
VITE_ACCESS_CODE=our-secret-code
