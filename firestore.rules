rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each couple gets their own {threadId} (derived from the Room Code
    // they both typed on the entry screen) — any number of private
    // rooms can share this same Firebase project without ever seeing
    // each other's data. There's nothing to scope per-user beyond "are
    // you signed in at all", since knowing the exact threadId already
    // requires knowing that couple's Room Code.
    match /threads/{threadId}/messages/{messageId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.sender in ['A', 'B']
        && request.resource.data.type in ['text', 'voice']
        && (
          (request.resource.data.type == 'text'
            && request.resource.data.message is string
            && request.resource.data.message.size() > 0
            && request.resource.data.message.size() <= 4000)
          ||
          (request.resource.data.type == 'voice'
            && request.resource.data.audioUrl is string
            && request.resource.data.audioUrl.size() > 0)
        );

      // A person may only edit or soft-delete their own message, and
      // only the content-ish fields — who sent it and when can never
      // change after the fact.
      allow update: if request.auth != null
        && request.resource.data.sender == resource.data.sender
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.type == resource.data.type;

      // Also used by "Clear chat", which hard-deletes the whole thread.
      allow delete: if request.auth != null;
    }

    // The single message currently pinned in this room (if any).
    match /threads/{threadId}/pinned/{pinId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /threads/{threadId}/presence/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && userId in ['A', 'B'];
    }

    // Each person's chosen display name (optional — set from the entry
    // screen). Shared so both people see the same name for each other.
    match /threads/{threadId}/profile/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && userId in ['A', 'B'];
    }

    // Ephemeral "is typing" flag. Same trust model as presence — either
    // person can only ever write their own slot.
    match /threads/{threadId}/typing/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && userId in ['A', 'B'];
    }

    // Audio-call signaling: one small doc holding the SDP offer/answer,
    // plus two subcollections for trickled ICE candidates. No audio/video
    // ever passes through Firestore — only this connection-setup metadata
    // does, and it's deleted again once the call ends.
    match /threads/{threadId}/call/{callId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.caller in ['A', 'B']
        && request.resource.data.callee in ['A', 'B'];
      allow update: if request.auth != null;
      allow delete: if request.auth != null;

      match /callerCandidates/{candidateId} {
        allow read, write: if request.auth != null;
      }
      match /calleeCandidates/{candidateId} {
        allow read, write: if request.auth != null;
      }
    }

    // Room-wide chat settings (currently just "disappearing messages"),
    // shared so both people see the same setting.
    match /threads/{threadId}/settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}